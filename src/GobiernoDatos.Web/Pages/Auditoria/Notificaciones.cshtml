@page
@model GobiernoDatos.Web.Pages.Auditoria.NotificacionesModel
@{
    ViewData["Title"] = "Auditoría · Notificaciones";
    ViewData["Nav"] = "auditoria";
    var notificadas = Model.PorMacro.Count(m => m.Notificado);
}

<header class="encabezado">
    <div class="titulo">
        <h1>Auditoría</h1>
        <p>Solicitud de validación a los responsables de cada macro área y VoBo del gerente: a quién se notificó y la evidencia</p>
    </div>
    <div class="acciones">
        @if (Model.Evento is not null)
        {
            <a class="btn btn-primario" asp-page-handler="Evidencia" asp-route-evento="@Model.Evento"
               title="Un .zip con el resumen en Excel, los correos enviados (.eml) y las constancias de VoBo del gerente (.eml)">Descargar evidencia</a>
        }
    </div>
</header>

<partial name="_Pestanas" model="@("Notificaciones")" />

<section class="panel" aria-labelledby="h-macro">
    <div class="panel-cab">
        <h2 id="h-macro">Por macro área</h2>
        <form method="get" class="compacto">
            <label class="campo en-linea">Evento
                <select name="evento" data-autosubmit>
                    @foreach (var e in Model.Eventos)
                    {
                        <option value="@e.EventoId" selected="@(e.EventoId == Model.Evento)">@e.Nombre · @ReglasRecertificacion.Etiqueta(e.Estatus)</option>
                    }
                </select>
            </label>
        </form>
    </div>
    @if (Model.PorMacro.Count == 0)
    {
        <div class="vacio">No hay eventos abiertos o cerrados.</div>
    }
    else
    {
        <div class="panel-cuerpo"><span class="sutil">@notificadas de @Model.PorMacro.Count macro áreas notificadas</span></div>
        <div class="tabla-scroll">
            <table class="tabla" id="tabla-notificacion-macro">
                <thead><tr><th>Macro área</th><th>Responsables</th><th>Notificado</th><th class="derecha">Envíos</th><th>Último envío</th><th>Correo</th><th class="derecha">Pendientes</th><th>Certificación</th><th>VoBo gerente</th></tr></thead>
                <tbody>
                    @foreach (var m in Model.PorMacro)
                    {
                        var u = m.Ultimo;
                        <tr data-macro="@m.MacroArea">
                            <td>@m.MacroArea</td>
                            <td>@(m.Responsables.Count == 0 ? "—" : string.Join(", ", m.Responsables))</td>
                            <td>@if (m.Notificado) { <span class="badge badge-ok">Sí</span> }
                                else if (m.Envios.Count > 0) { <span class="badge badge-error" title="@m.Envios[0].Error">No enviado</span> }
                                else { <span class="badge badge-aviso">No</span> }</td>
                            <td class="num">@m.Envios.Count(e => e.Enviado)</td>
                            <td>@if (u is not null) { <span class="mono">@u.Fecha.ToString("yyyy-MM-dd HH:mm")</span><span class="secundario">@u.Certificador · @u.Correo</span> } else { <span class="sutil">—</span> }</td>
                            <td>@if (u?.TieneCorreo == true) { <a asp-page-handler="Correo" asp-route-id="@u.RecordatorioId">Descargar .eml</a> }
                                else if (u is not null) { <span class="ayuda">Enviado antes de guardar el correo</span> }</td>
                            <td class="num">@m.Pendientes</td>
                            <td>@if (m.Confirmada) { <span class="badge badge-ok">Confirmada</span> } else { <span class="sutil">—</span> }</td>
                            <td>@if (m.VoBo is { } vb)
                                {
                                    <span class="badge @(vb.Estatus == EstatusVoBo.AUTORIZADA ? "badge-ok" : vb.Estatus == EstatusVoBo.RECHAZADA ? "badge-error" : "badge-aviso")">@NotificacionesModel.Etiqueta(vb.Estatus)</span>
                                    <a asp-page-handler="VoBo" asp-route-id="@vb.VoBoId" asp-route-evento="@Model.Evento" style="display:block">Descargar constancia (.eml)</a>
                                }
                                else { <span class="sutil">—</span> }</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="panel" aria-labelledby="h-vobo" id="vobo-gerente">
    <div class="panel-cab">
        <h2 id="h-vobo">VoBo del gerente</h2>
        <span class="sutil">Solicitudes enviadas por Power Automate al gerente y su respuesta; la constancia es un correo (.eml) con las bajas que se pidió autorizar</span>
    </div>
    @if (Model.VoBos.Count == 0)
    {
        <div class="vacio">No se ha solicitado el VoBo del gerente en este evento.</div>
    }
    else
    {
        <div class="tabla-scroll">
            <table class="tabla" id="tabla-vobo-gerente">
                <thead><tr><th>Macro área</th><th>Gerente</th><th class="derecha">Bajas</th><th>Solicitud</th><th>Envío</th><th>Respuesta</th><th>Evidencia</th></tr></thead>
                <tbody>
                    @foreach (var v in Model.VoBos)
                    {
                        <tr data-vobo="@v.VoBoId">
                            <td>@v.MacroArea</td>
                            <td>@v.GerenteNombre<span class="secundario">@v.GerenteCorreo</span></td>
                            <td class="num">@v.Bajas</td>
                            <td><span class="mono">@v.FechaSolicitud.ToString("yyyy-MM-dd HH:mm")</span><span class="secundario">@v.SolicitadoPor</span></td>
                            <td class="mono">@(v.FechaEnvio?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                            <td>
                                <span class="badge @(v.Estatus == EstatusVoBo.AUTORIZADA ? "badge-ok" : v.Estatus == EstatusVoBo.RECHAZADA ? "badge-error" : "badge-aviso")">@NotificacionesModel.Etiqueta(v.Estatus)</span>
                                @if (v.FechaRespuesta is { } fr) { <span class="secundario">@v.RespondidoPor · @fr.ToString("yyyy-MM-dd HH:mm")@(v.Comentario is null ? "" : " · " + v.Comentario)</span> }
                                @if (v.MotivoCancelacion is not null) { <span class="secundario">@v.MotivoCancelacion</span> }
                            </td>
                            <td><a asp-page-handler="VoBo" asp-route-id="@v.VoBoId" asp-route-evento="@Model.Evento">Descargar constancia (.eml)</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="panel" aria-labelledby="h-envios">
    <div class="panel-cab">
        <h2 id="h-envios">Correos enviados</h2>
        <span class="sutil">Cada intento de notificación (recordatorios de Eventos), con su resultado</span>
    </div>
    @if (Model.Envios.Count == 0)
    {
        <div class="vacio">No se han enviado notificaciones en este evento.</div>
    }
    else
    {
        <div class="tabla-scroll">
            <table class="tabla" id="tabla-envios">
                <thead><tr><th>Fecha</th><th>Responsable</th><th>Correo</th><th>Macro áreas</th><th>Asunto</th><th class="derecha">Pendientes</th><th>Resultado</th><th>Envió</th><th>Evidencia</th></tr></thead>
                <tbody>
                    @foreach (var e in Model.Envios)
                    {
                        <tr>
                            <td class="mono">@e.Fecha.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@e.Certificador<span class="secundario">@e.UsuarioRed</span></td>
                            <td class="mono">@Ui.Texto(e.Correo, "—")</td>
                            <td>@e.MacroAreas</td>
                            <td>@Ui.Texto(e.Asunto, "—")</td>
                            <td class="num">@e.Pendientes</td>
                            <td>@if (e.Enviado) { <span class="badge badge-ok">Enviado</span> } else { <span class="badge badge-error">No enviado</span><span class="ayuda" style="display:block">@e.Error</span> }</td>
                            <td class="mono">@e.EnviadoPor</td>
                            <td>@if (e.TieneCorreo) { <a asp-page-handler="Correo" asp-route-id="@e.RecordatorioId">Descargar .eml</a> } else { <span class="sutil">—</span> }</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    <div class="panel-pie"><span>El .eml es el correo tal como salió del portal (remitente, destinatario, fecha, asunto y cuerpo); se abre con Outlook.</span></div>
</section>
