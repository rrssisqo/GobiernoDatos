@page
@model GobiernoDatos.Web.Pages.Recertificacion.BajasModel
@{
    ViewData["Title"] = "Bajas y evidencia";
    ViewData["Nav"] = "bajas";
    var t = Model.Tablero;
    var sel = Model.Seleccionada;
}

<header class="encabezado">
    <div class="titulo">
        <h1>Bajas y evidencia</h1>
        <p>Accesos marcados como Baja: ejecución por TI y evidencia para auditoría</p>
    </div>
    @if (t is not null)
    {
        <form method="get" class="acciones">
            <label class="campo">Evento
                <select name="evento" data-autosubmit>
                    @foreach (var e in Model.Eventos) { <option value="@e.EventoId" selected="@(e.EventoId == t.Evento.EventoId)">@e.Nombre · @ReglasRecertificacion.Etiqueta(e.Estatus)</option> }
                </select>
            </label>
            @if (Model.Macro is not null) { <input type="hidden" name="macro" value="@Model.Macro" /> }
            <a class="btn" asp-page-handler="Evidencia" asp-route-evento="@t.Evento.EventoId">Exportar evidencia</a>
        </form>
    }
</header>

@if (t is null)
{
    <div class="panel"><div class="vacio">No hay eventos de recertificación.</div></div>
}
else
{
    <section class="kpis" aria-label="Indicadores">
        <div class="kpi"><span class="etq">Bajas decididas</span><span class="valor">@Model.DelArea.Count</span><span class="nota">@(Model.Macro ?? "Todas las macro áreas")</span></div>
        <div class="kpi"><span class="etq">Ejecutadas</span><span class="valor">@Model.Ejecutadas</span></div>
        <div class="kpi"><span class="etq">Pendientes de ejecución</span><span class="valor">@(Model.DelArea.Count - Model.Ejecutadas)</span><span class="nota">@Model.MacroAreas.Count(m => !m.Autorizada) macro áreas sin VoBo autorizado</span></div>
        <div class="kpi"><span class="etq">Días promedio para ejecutar</span><span class="valor">@(Model.DiasPromedio is null ? "—" : Model.DiasPromedio.Value.ToString("0.#"))</span></div>
    </section>

    <section class="panel" aria-labelledby="h-vobo" id="vobo">
        <div class="panel-cab">
            <h2 id="h-vobo">VoBo del gerente por macro área</h2>
            <span class="sutil">El ticket de una baja solo se registra con el VoBo autorizado del gerente de su macro área.</span>
        </div>
        @if (Model.MacroAreas.Count == 0)
        {
            <div class="vacio">No hay macro áreas con bajas@(Model.Macro is null ? "" : " en " + Model.Macro).</div>
        }
        else
        {
            <div class="tabla-scroll">
                <table class="tabla" id="tabla-vobo">
                    <thead><tr><th>Macro área</th><th class="derecha">Bajas</th><th class="derecha">Ejecutadas</th><th>Gerente</th><th>VoBo</th><th><span class="oculto-visual">Acción</span></th></tr></thead>
                    <tbody>
                        @foreach (var m in Model.MacroAreas)
                        {
                            var v = m.VoBo;
                            <tr data-macro="@m.MacroArea">
                                <td>@m.MacroArea</td>
                                <td class="num">@m.Bajas</td>
                                <td class="num">@m.Ejecutadas</td>
                                <td>@if (m.Gerente is null) { <a asp-page="MacroAreas" asp-fragment="gerente"><span class="badge badge-aviso">Sin gerente</span></a> }
                                    else { @m.Gerente.Nombre<span class="secundario">@m.Gerente.Correo</span> }</td>
                                <td>
                                    @switch (v?.Estatus)
                                    {
                                        case null: <span class="badge badge-neutro">Sin solicitar</span> break;
                                        case EstatusVoBo.PENDIENTE: <span class="badge badge-aviso">Por enviar</span><span class="secundario">Solicitado @Ui.FechaHora(v.FechaSolicitud) · @v.SolicitadoPor</span> break;
                                        case EstatusVoBo.ENVIADA: <span class="badge badge-aviso">Esperando al gerente</span><span class="secundario">Enviado @Ui.FechaHora(v.FechaEnvio!.Value) a @v.GerenteNombre</span> break;
                                        case EstatusVoBo.AUTORIZADA: <span class="badge badge-ok">Autorizado</span><span class="secundario">@v.RespondidoPor · @Ui.FechaHora(v.FechaRespuesta!.Value)@(v.Comentario is null ? "" : " · " + v.Comentario)</span> break;
                                        case EstatusVoBo.RECHAZADA: <span class="badge badge-error">Rechazado</span><span class="secundario">@v.RespondidoPor · @Ui.FechaHora(v.FechaRespuesta!.Value)@(v.Comentario is null ? "" : " · " + v.Comentario)</span> break;
                                        default: <span class="badge badge-neutro">Cancelado</span><span class="secundario">@v.MotivoCancelacion</span> break;
                                    }
                                </td>
                                <td>
                                    @if (m.Autorizada) { }
                                    else if (m.PorDecidir > 0 && t.Evento.Estatus == EstatusEvento.ABIERTO)
                                    {
                                        <span class="ayuda">Faltan @m.PorDecidir decisiones del certificador</span>
                                    }
                                    else if (m.Gerente is null)
                                    {
                                        <span class="ayuda">Asigna el gerente en Macro áreas</span>
                                    }
                                    else
                                    {
                                        <form method="post" asp-page-handler="SolicitarVoBo" asp-route-evento="@t.Evento.EventoId" asp-route-estatus="@Model.Estatus" asp-route-macro="@Model.Macro" class="inline"
                                              data-confirmar="Se pedirá a @m.Gerente.Nombre el VoBo de @m.Bajas bajas de @m.MacroArea por Power Automate. ¿Continuar?">
                                            <input type="hidden" name="macroAreaId" value="@m.MacroAreaId" />
                                            <input type="hidden" name="macroArea" value="@m.MacroArea" />
                                            <button type="submit" class="btn btn-chico">@(m.SolicitudActiva ? "Volver a solicitar" : "Solicitar VoBo")</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <div class="dos-columnas">
        <section class="panel" aria-labelledby="h-b">
            <div class="panel-cab">
                <h2 id="h-b">Bajas del evento</h2>
                <form method="get" class="compacto filtros-bajas">
                    <input type="hidden" name="evento" value="@t.Evento.EventoId" />
                    <label class="campo en-linea">Macro área
                        <select name="macro" data-autosubmit>
                            <option value="">Todas</option>
                            @foreach (var m in t.MacroAreas) { <option value="@m.MacroArea" selected="@(m.MacroArea == Model.Macro)">@m.MacroArea</option> }
                        </select>
                    </label>
                    <label class="campo en-linea">Estatus
                        <select name="estatus" data-autosubmit>
                            <option value="">Todas</option>
                            <option value="PENDIENTES" selected="@(Model.Estatus == "PENDIENTES")">Pendientes</option>
                            <option value="EJECUTADAS" selected="@(Model.Estatus == "EJECUTADAS")">Ejecutadas</option>
                        </select>
                    </label>
                </form>
            </div>
            @{ var porAsignar = Model.MacroAreas.Where(m => m.Autorizada && m.Bajas > m.Ejecutadas).ToList(); }
            @if (porAsignar.Count > 0)
            {
                <div class="asignacion-infra" id="asignacion-infra">
                    <h3>Asignar a infraestructura</h3>
                    @if (Model.ResponsableInfra is { } ri)
                    {
                        <p class="ayuda">Responsable: <strong>@ri.Nombre</strong> (@ri.Correo). Recibe un correo con el número de cambio y las bajas por ejecutar en Excel.
                           <a asp-page="MacroAreas" asp-fragment="responsable-infra">Cambiar</a></p>
                    }
                    else
                    {
                        <p class="ayuda"><span class="badge badge-aviso">Sin responsable de infraestructura</span>
                           Asígnalo en <a asp-page="MacroAreas" asp-fragment="responsable-infra">Macro áreas</a> para poder asignar las bajas.</p>
                    }
                    @foreach (var m in porAsignar)
                    {
                        <div class="asignacion-fila" data-macro-infra="@m.MacroArea">
                            <div class="asignacion-estado">
                                <strong>@m.MacroArea</strong> <span class="sutil">· @(m.Bajas - m.Ejecutadas) por ejecutar</span>
                                @if (m.Infra is { } inf)
                                {
                                    <span class="secundario">Asignado a @inf.ResponsableNombre · cambio <span class="mono">@inf.Cambio</span> · @Ui.FechaHora(inf.Fecha)</span>
                                    @if (inf.Notificado) { <span class="badge badge-ok">Correo enviado</span> }
                                    else { <span class="badge badge-error" title="@inf.Error">Correo no enviado</span> <span class="ayuda">@inf.Error</span> }
                                }
                            </div>
                            <form method="post" asp-page-handler="AsignarInfra" asp-route-evento="@t.Evento.EventoId" asp-route-estatus="@Model.Estatus" asp-route-macro="@Model.Macro"
                                  class="form-fila compacto"
                                  data-confirmar="Se asignarán @(m.Bajas - m.Ejecutadas) bajas de @m.MacroArea y se enviará el correo con el Excel al responsable. ¿Continuar?">
                                <input type="hidden" name="macroAreaId" value="@m.MacroAreaId" />
                                <input type="hidden" name="macroArea" value="@m.MacroArea" />
                                <input type="text" name="cambio" required maxlength="60" placeholder="Número de cambio" value="@m.Infra?.Cambio"
                                       aria-label="Número de cambio para @m.MacroArea" class="mono" style="flex:1 1 160px" />
                                <button type="submit" class="btn btn-chico btn-primario" style="flex:0 0 auto" disabled="@(Model.ResponsableInfra is null)">@(m.Infra is null ? "Asignar y avisar" : "Reasignar y avisar")</button>
                            </form>
                        </div>
                    }
                </div>
            }
            @if (Model.Filas.Count == 0)
            {
                <div class="vacio">@(t.Decididas == 0 ? "Ningún certificador ha marcado bajas en este evento." : "No hay bajas con este estatus.")</div>
            }
            else
            {
                <div class="tabla-scroll">
                    <table class="tabla">
                        <thead><tr><th class="col-nombre">Usuario</th><th>Vista · rol a retirar</th><th>Macro área</th><th>Decidió</th><th>Comentario</th><th>Infraestructura</th><th>Ejecución</th></tr></thead>
                        <tbody>
                            @foreach (var f in Model.Filas)
                            {
                                var url = Url.Page("Bajas", new { evento = t.Evento.EventoId, estatus = Model.Estatus, macro = Model.Macro, acceso = f.AccesoId });
                                var area = Model.AreaDe(f);
                                <tr class="@(sel?.AccesoId == f.AccesoId ? "seleccionada" : "")">
                                    <td><a href="@url">@f.UsuarioNombre</a><span class="secundario">@f.UsuarioCodigo</span></td>
                                    <td class="ruta"><span class="mono" style="font-size:12px">@f.Vista</span><span class="secundario">@f.Rol</span></td>
                                    <td>@f.MacroArea</td>
                                    <td>@f.DecididoPor<span class="ayuda" style="display:block">@Ui.FechaHora(f.FechaDecision)</span></td>
                                    <td>@f.Comentario</td>
                                    <td>@if (area?.Infra is { } infra) { @infra.ResponsableNombre<span class="secundario">Cambio <span class="mono">@infra.Cambio</span></span> }
                                        else { <span class="sutil">—</span> }</td>
                                    <td>
                                        @if (f.Ejecucion is not null)
                                        {
                                            <span class="badge badge-ok">Ejecutada · @Ui.Fecha(f.Ejecucion.FechaEjecucion)</span>
                                            <span class="secundario">Ticket @f.Ejecucion.Ticket
                                                <button type="button" class="enlace-peligro" data-anular="@f.AccesoId" data-ticket="@f.Ejecucion.Ticket" data-usuario="@f.UsuarioNombre">Quitar ticket</button></span>
                                        }
                                        else if (area?.Autorizada != true)
                                        {
                                            <span class="badge badge-aviso">Requiere VoBo del gerente</span>
                                        }
                                        else if (area.Infra is null)
                                        {
                                            <span class="badge badge-aviso">Por asignar a infraestructura</span>
                                        }
                                        else
                                        {
                                            <form method="post" asp-page-handler="Ejecutar" asp-route-evento="@t.Evento.EventoId" asp-route-estatus="@Model.Estatus" asp-route-macro="@Model.Macro" class="form-fila compacto" style="min-width:260px">
                                                <input type="hidden" name="accesoId" value="@f.AccesoId" />
                                                <input type="text" name="ticket" aria-label="Ticket" placeholder="Ticket" required maxlength="60" value="@area.Infra.Cambio" style="flex:1 1 100px" />
                                                <button type="submit" class="btn btn-chico" style="flex:0 0 auto">Registrar ejecución</button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <aside class="panel lateral" aria-labelledby="h-tr">
            <div class="panel-cab"><h2 id="h-tr">Traza de auditoría</h2></div>
            <div class="panel-cuerpo">
                @if (sel is null)
                {
                    <p class="sutil">Selecciona una baja para ver su traza.</p>
                }
                else
                {
                    <span class="sutil">Acceso seleccionado: @sel.UsuarioNombre · @RutaTecnica.Vista(sel.Vista)</span>
                    <div class="traza">
                        @foreach (var p in Model.Traza)
                        {
                            <div class="paso"><span class="punto"></span><div><span>@p.Titulo</span><span class="det">@p.Detalle · @Ui.FechaHora(p.Fecha)</span></div></div>
                        }
                        @if (sel.Ejecucion is null)
                        {
                            <div class="paso"><span class="punto" style="background:var(--control)"></span><div><span class="sutil">Rol pendiente de retirar</span></div></div>
                        }
                    </div>
                }
            </div>
        </aside>
    </div>
}

@if (t is not null)
{
    <dialog id="dlg-anular" class="dialogo" aria-labelledby="h-anular">
        <form method="post" asp-page-handler="Anular" asp-route-evento="@t.Evento.EventoId" asp-route-estatus="@Model.Estatus" asp-route-macro="@Model.Macro" id="form-anular">
            <h2 id="h-anular">Quitar el ticket <span class="mono" id="anular-ticket"></span></h2>
            <p class="ayuda">Baja de <strong id="anular-usuario"></strong>. El ticket queda como anulado en la traza de auditoría y la baja vuelve a
               pendiente de ejecución; para registrar otro ticket se necesita el VoBo autorizado del gerente.</p>
            <input type="hidden" name="accesoId" />
            <input type="hidden" name="ticket" />
            <label class="campo">Motivo *
                <textarea name="motivo" rows="3" required maxlength="500" placeholder="Por qué se quita el ticket"></textarea>
            </label>
            <div class="form-fila" style="justify-content:flex-end">
                <button type="button" class="btn" id="btn-cancelar-anular" style="flex:0 0 auto">Cancelar</button>
                <button type="submit" class="btn btn-peligro" style="flex:0 0 auto">Quitar ticket</button>
            </div>
        </form>
    </dialog>
}

@section Scripts {
<script>
(() => {
    const dlg = document.getElementById('dlg-anular');
    if (!dlg) return;
    const f = document.getElementById('form-anular');
    document.querySelectorAll('[data-anular]').forEach(b => b.addEventListener('click', () => {
        f.elements.accesoId.value = b.dataset.anular;
        f.elements.ticket.value = b.dataset.ticket;
        f.elements.motivo.value = '';
        document.getElementById('anular-ticket').textContent = b.dataset.ticket;
        document.getElementById('anular-usuario').textContent = b.dataset.usuario;
        dlg.showModal();
        f.elements.motivo.focus();
    }));
    document.getElementById('btn-cancelar-anular').addEventListener('click', () => dlg.close());
})();
</script>
}
